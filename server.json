{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.xinvxueyuan/novelai-image-mcp",
  "title": "NovelAI Image MCP",
  "description": "NovelAI image generation as MCP tools: txt2img, img2img, inpaint, upscale, Director, ControlNet.",
  "version": "0.1.5",
  "websiteUrl": "https://xinvxueyuan.github.io/NovelAI-Image-MCP/",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "novelai-image-mcp",
      "version": "0.1.5",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "novelai-image-mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "environmentVariables": [
        {
          "name": "NOVELAI_TOKEN",
          "description": "NovelAI persistent API token (preferred auth). Get from https://novelai.net/account",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/xinvxueyuan/novelai-image-mcp:0.1.5",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "run"
        },
        {
          "type": "positional",
          "value": "--rm"
        },
        {
          "type": "positional",
          "value": "-i"
        },
        {
          "type": "positional",
          "value": "-e"
        },
        {
          "type": "positional",
          "value": "NOVELAI_TOKEN"
        }
      ],
      "environmentVariables": [
        {
          "name": "NOVELAI_TOKEN",
          "description": "NovelAI persistent API token (preferred auth). Get from https://novelai.net/account",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/xinvxueyuan/NovelAI-Image-MCP",
    "source": "github",
    "id": "1311561050"
  }
}
