#!/usr/bin/env sh
# POSIX-compliant shell; invoked via .husky/_/h with `sh -e` (shebang is informational)
#
# Pre-commit hook: auto-fix → markdown → python checks
# Phases (fast-feedback first, blocking before non-blocking analysis):
#   Phase 1   prek          auto-fix (ruff --fix + ruff-format + general hooks)
#   Phase 2   markdownlint  .md validation
#   Phase 3   Pyright       type checking (slow; only on apps/server .py changes)
#   Phase 4   pytest        unit tests (slowest; only on apps/server .py changes)
#
# Workspace layout (uv monorepo):
#   apps/server/   installable MCP server package — Python tooling (ruff,
#                  pyright, pytest, poethepoet) all live in
#                  apps/server/pyproject.toml.
#   apps/docs/     Sphinx documentation site (virtual project) — no tests,
#                  no pyright, no ruff config.
#
# Pre-requisites (installed by `uv sync` / `pnpm install`):
#   - uv                https://docs.astral.sh/uv/
#   - pnpm              https://pnpm.io/  (for markdownlint-cli2)
#   - prek              https://github.com/j178/prek  (via lint dependency-group)
set +e

# ── Locate the husky directory (POSIX, no readlink) ────────────────
HUSKY_DIR=$(dirname "$0")
case "$HUSKY_DIR" in
    /*) ;;
    *)  HUSKY_DIR="$PWD/$HUSKY_DIR" ;;
esac
HUSKY_DIR=$(cd "$HUSKY_DIR" && pwd)

# ── Tool resolution ──────────────────────────────────────────────────
GIT_CMD=${GIT_CMD:-git}
UV_CMD=${UV_CMD:-uv}
PNPM_RUNNER=${PNPM_RUNNER:-pnpm}

# Detect whether uv / pnpm are on PATH; missing tools degrade gracefully.
if ! command -v "$UV_CMD" >/dev/null 2>&1; then
    UV_CMD=""
fi
if ! command -v "$PNPM_RUNNER" >/dev/null 2>&1; then
    PNPM_RUNNER=""
fi

# ── Staged file detection (cheap pre-filter; skips everything if no files) ──
STAGED=$("$GIT_CMD" diff --cached --name-only --diff-filter=ACM 2>/dev/null)
if [ -z "$STAGED" ]; then
    # Nothing staged — nothing to check.
    exit 0
fi

# Split into per-workspace buckets so the slow Python phases only run when
# apps/server source actually changes (docs conf.py changes don't need pyright
# or pytest, since they're outside the server's [tool.pyright] / testpaths).
MD_STAGED=$(printf '%s\n' "$STAGED" | grep -E '\.md$' || true)
PY_SERVER_STAGED=$(printf '%s\n' "$STAGED" | grep -E '^apps/server/.*\.py$' || true)

echo "🚀 Running pre-commit checks..."

# ── Phase 1: prek auto-fix (always runs; gates everything) ─────────
# prek runs its own staged-file filtering by stage. If prek modifies files
# (ruff --fix, ruff-format, end-of-file-fixer), we re-stage and retry once.
# prek discovers the [tool.ruff] config per file (walking up from each file),
# so apps/server/src/**/*.py uses apps/server/pyproject.toml and
# apps/docs/source/conf.py uses apps/docs/pyproject.toml.
if [ -n "$UV_CMD" ]; then
    echo "🔧 Running prek auto-fix..."
    if ! "$UV_CMD" run prek validate-config prek.toml ||
       ! "$UV_CMD" run prek run --config prek.toml --stage pre-commit; then
        echo "ℹ️  prek modified files — re-staging and retrying..."
        "$GIT_CMD" add -u
        if ! "$UV_CMD" run prek validate-config prek.toml ||
           ! "$UV_CMD" run prek run --config prek.toml --stage pre-commit; then
            echo "❌ prek checks failed. Fix the issues and re-stage."
            exit 1
        fi
    fi
else
    echo "⚠️  uv not found — skipping prek auto-fix."
fi

# ── Phase 2: markdownlint (only on .md changes) ────────────────────
# Pass staged .md files explicitly so unchanged docs don't slow the run.
# markdownlint-cli2 still applies the repo-wide .markdownlint-cli2.jsonc
# config (rules + ignores) to each file.
if [ -n "$MD_STAGED" ] && [ -n "$PNPM_RUNNER" ]; then
    echo "📝 Running markdownlint..."
    if ! "$PNPM_RUNNER" exec markdownlint-cli2 $MD_STAGED; then
        echo "❌ markdownlint failed. Run 'pnpm exec markdownlint-cli2 --fix' to auto-fix."
        exit 1
    fi
elif [ -n "$MD_STAGED" ]; then
    echo "⚠️  pnpm not found — skipping markdownlint."
fi

# ── Phase 3: Pyright (only on apps/server .py changes) ─────────────
# Scope to apps/server via --directory so pyright picks up the
# [tool.pyright] config from apps/server/pyproject.toml (include = ["src",
# "tests"]). Changes to apps/docs/source/conf.py are out of scope — they
# are not part of the publishable server package.
if [ -n "$PY_SERVER_STAGED" ] && [ -n "$UV_CMD" ]; then
    echo "🔍 Running Pyright..."
    if ! "$UV_CMD" run --directory apps/server -m pyright; then
        echo "❌ Pyright failed. Fix the type errors and re-stage."
        exit 1
    fi
fi

# ── Phase 4: pytest (only on apps/server .py changes; slowest) ──────
# Tests live at apps/server/tests and are configured via
# [tool.pytest.ini_options] in apps/server/pyproject.toml. Scope with
# --directory so pytest picks up pythonpath, testpaths, addopts correctly.
if [ -n "$PY_SERVER_STAGED" ] && [ -n "$UV_CMD" ]; then
    echo "🧪 Running pytest..."
    if ! "$UV_CMD" run --directory apps/server -m pytest -q --no-header --timeout=60 -p no:cacheprovider; then
        echo "❌ pytest failed. Fix the failing tests and re-stage."
        exit 1
    fi
fi

echo "✅ All checks passed!"
