# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging (per workspace member + repo-wide)
.Python
build/
dist/
*.egg-info/
*.egg
.installed.cfg

# Virtual environments (single shared venv at the workspace root)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.ruff_cache/
.uv-python

# uv cache
.uv-cache/

# ===== Test & coverage =====
htmlcov/
.coverage
.coverage.*
.cache
.pytest_cache/
coverage.xml
test-results/
*.cover
*.lcov

# ===== Runtime output =====
# Generated images are written here by default (NOVELAI_OUTPUT_DIR).
outputs/

# ===== Environment files =====
.env
.env.*
!.env.example

# ===== IDE / Editor =====
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# ===== OS =====
.DS_Store
Thumbs.db
*.swp
*.swo

# ===== Logs =====
*.log

# ===== Agent / tool caches =====
.trae/
.codex/
.firecrawl/

# ===== Node.js (cross-cutting tooling via pnpm) =====
# Node-side tooling (turbo + husky + markdownlint) is installed via pnpm; the
# bundled third-party code under node_modules/ is never committed.
node_modules/
pnpm-store/

# This project standardizes on pnpm (see package.json ``packageManager``).
# Guard against accidental ``npm install`` runs that drop a stray lockfile.
package-lock.json

# ===== Turborepo =====
# ``.turbo/`` caches turbo's task outputs; ``turbo-*.log`` is the daemon log.
.turbo/
**/.turbo/

# ===== Sphinx docs build (apps/docs) =====
# Generated HTML lives at apps/docs/_build/. Never commit build output.
apps/docs/_build/

# ===== Workspace per-member build artifacts =====
# Each workspace member may produce its own dist/build dir; ignore them all
# so a stale build in one member never leaks into a commit.
**/dist/
**/build/
**/*.egg-info/
