{
  "name": "novelai-image-mcp",
  "version": "0.7.1",
  "private": true,
  "description": "NovelAI Image MCP monorepo: MCP server + Sphinx docs site",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "reuse": "uv run reuse lint",
    "serve": "turbo run serve",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "linkcheck": "turbo run linkcheck",
    "docs:build": "turbo run build --filter=@novelai-image-mcp/docs",
    "docs:build:zh": "turbo run build:zh --filter=@novelai-image-mcp/docs",
    "docs:build:ja": "turbo run build:ja --filter=@novelai-image-mcp/docs",
    "docs:build:all": "turbo run build:all --filter=@novelai-image-mcp/docs",
    "docs:serve": "turbo run serve --filter=@novelai-image-mcp/docs",
    "docs:serve:zh": "turbo run serve:zh --filter=@novelai-image-mcp/docs",
    "docs:serve:ja": "turbo run serve:ja --filter=@novelai-image-mcp/docs",
    "docs:linkcheck": "turbo run linkcheck --filter=@novelai-image-mcp/docs",
    "server:build": "turbo run build --filter=@novelai-image-mcp/server",
    "server:serve": "turbo run serve --filter=@novelai-image-mcp/server",
    "markdownlint": "markdownlint-cli2",
    "markdownlint:fix": "markdownlint-cli2 --fix",
    "readme:check": "node .github/scripts/check-readmes.mjs",
    "readme:test": "node --test .github/scripts/check-readmes.test.mjs",
    "check": "turbo run lint typecheck test && pnpm readme:check && pnpm readme:test && pnpm exec markdownlint-cli2",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint-plugin-turbo": "^2.11.10",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.24.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.10"
  }
}
