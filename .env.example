# ─────────────────────────────────────────────────────────────────────────────
# NovelAI Image MCP — environment configuration
# Copy to `.env` and fill in. All variables are optional unless noted.
# ─────────────────────────────────────────────────────────────────────────────

# ── NovelAI credentials (one of the two auth methods is required) ─────────────
# Method A (preferred): a persistent API token from https://novelai.net/ > Account.
NOVELAI_TOKEN=

# Method B: username + password; the access key is derived with argon2id.
#argon2-cffi must be installed (it is a core dependency).
NOVELAI_USERNAME=
NOVELAI_PASSWORD=

# ── NovelAI endpoints (override only for testing/custom deployments) ─────────
NOVELAI_IMAGE_BASE_URL=https://image.novelai.net
NOVELAI_ACCOUNT_BASE_URL=https://image.novelai.net
NOVELAI_TIMEOUT=120

# ── Generation defaults (overridable per tool call) ──────────────────────────
NOVELAI_DEFAULT_MODEL=nai-diffusion-4-5-full
NOVELAI_DEFAULT_WIDTH=832
NOVELAI_DEFAULT_HEIGHT=1216
NOVELAI_DEFAULT_STEPS=28
NOVELAI_DEFAULT_SCALE=5.0
NOVELAI_DEFAULT_SAMPLER=k_euler_ancestral

# ── Vibe-transfer reference encoding cache size ──────────────────────────────
NOVELAI_VIBE_CACHE_ENTRIES=64

# ── Output directory for saved images (returned as file paths) ───────────────
NOVELAI_OUTPUT_DIR=outputs

# ── MCP server transport ──────────────────────────────────────────────────────
# stdio  – for local agent integration (Claude Desktop, Cline, etc.)
# streamable-http – for remote / multi-client deployments (uses MCP_HOST/PORT)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# MCP endpoint path for streamable-http transport
MCP_PATH=/mcp
